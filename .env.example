# REQUIRED - MCP bearer token. Server-side only. NEVER prefix with NEXT_PUBLIC_.
AQ_TOKEN=

# OPTIONAL persistence (recommended on Vercel). Auto-detected, first match wins:
# Upstash Redis / Vercel KV (add the Upstash integration in Vercel -> vars are injected)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV legacy names also work: KV_REST_API_URL / KV_REST_API_TOKEN)

# If none set: falls back to a JSON file in /tmp (survives warm lambdas only), then memory.
# AQ_STORE_FILE=/tmp/aq-store.json
